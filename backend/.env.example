# ==============================================================================
# Backend Environment Configuration (FastAPI)
# ==============================================================================

# Database connection URL for SQLAlchemy (transaction pooler on port 6543)
DATABASE_URL=postgresql+psycopg://postgres.your-project-id:your-db-password@aws-0-us-east-2.pooler.supabase.com:6543/postgres

# Direct database connection URL for Alembic migrations (session mode on port 5432)
DIRECT_URL=postgresql+psycopg://postgres.your-project-id:your-db-password@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# Supabase Project Credentials (found under Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase JWT Secret used to verify incoming trainer tokens
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# Anthropic Claude API Key for the AI agent progression and extraction services
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-placeholder

# Server configuration
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Allowed frontend origin URLs for CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
