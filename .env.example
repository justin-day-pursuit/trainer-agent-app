# ==============================================================================
# Trainer Progression App — Master Environment Configuration Template
# ==============================================================================
# This template documents all required variables for both frontend and backend.
# Copy this file to `.env` in the root (for reference) or use the specific
# `.env.example` templates in `backend/` and `frontend/` respectively.
#
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Shared by Backend & Frontend)
# ------------------------------------------------------------------------------
# Your Supabase project URL (found under Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase public anon key for frontend client requests
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Supabase JWT Secret (found under Project Settings -> API -> JWT Settings).
# Used by the FastAPI backend to securely verify incoming trainer auth tokens.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-placeholder

# ------------------------------------------------------------------------------
# BACKEND & DATABASE CONFIGURATION (FastAPI / Render)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for SQLAlchemy (async with psycopg / asyncpg).
# Example format: postgresql+psycopg://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
DATABASE_URL=postgresql+psycopg://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Port and environment mode for FastAPI
PORT=8000
ENVIRONMENT=development
DEBUG=true

# Allowed CORS origins for the backend (comma-separated if multiple)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# AI PROVIDER CREDENTIALS (Used by Backend Progression & Extraction Agents)
# ------------------------------------------------------------------------------
# Anthropic API Key for Claude-powered extraction and review agents
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-placeholder

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Next.js / Vercel)
# ------------------------------------------------------------------------------
# The public URL of the running FastAPI backend that the frontend connects to
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Supabase public credentials exposed to the Next.js client browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
